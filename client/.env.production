# Production / Android build config for the Vite frontend.
#
# Copy this file to `.env.production` and set the value to your deployed
# backend's public HTTPS URL (the Render service URL) WITHOUT a trailing slash
# and WITHOUT the `/api/v1` suffix — the API client appends that itself.
#
#   cp .env.production.example .env.production
#   # then edit the URL below
#
# Local `npm run dev` ignores this file (it uses the Vite proxy), so dev is
# unaffected. This is only read by `npm run build` (and therefore the APK).

VITE_API_URL=https://leyble-hub.onrender.com
